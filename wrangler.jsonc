{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitblog-related",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".deploy",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "gitblog.app/related/v1/*", "zone_name": "gitblog.app" }
  ]
}
